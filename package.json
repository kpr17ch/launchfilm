{
  "name": "launchfilm",
  "version": "0.1.0",
  "description": "Turn any product URL into a launch film. Captures the site, extracts the brand, plans a storyboard and renders it with Remotion.",
  "type": "module",
  "license": "MIT",
  "author": "Kai Perich (https://github.com/kpr17ch)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kpr17ch/launchfilm.git"
  },
  "keywords": [
    "remotion",
    "video",
    "launch-video",
    "playwright",
    "product-video",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "launchfilm": "bin/launchfilm.mjs"
  },
  "scripts": {
    "launchfilm": "tsx src/cli.ts",
    "studio": "remotion studio src/video/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "example:serve": "node scripts/serve-example.mjs",
    "demo": "node scripts/render-demo.mjs",
    "test:e2e": "LAUNCHFILM_E2E=1 vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "commander": "15.1.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
